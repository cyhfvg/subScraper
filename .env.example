# Copy to .env and fill in:
#   cp .env.example .env
# Do not commit .env. docker compose reads this file automatically.

# Image tag from `docker load` / `docker build -t ...`
IMAGE_NAME=subscraper:latest

# Compose 容器名
CONTAINER_NAME=subscraper

# Host port -> container 8342
SUBSCRAPER_PORT=8342

# Bind-mount for state, users, screenshots, backups
RECON_DATA_DIR=./recon_data

# First boot with an empty recon_data creates this admin.
# Username: 3+ chars, [A-Za-z0-9_-]
# Password: 6+ chars
SUBSCRAPER_ADMIN_USER=admin
SUBSCRAPER_ADMIN_PASSWORD=change-me-now

# 1 = do not apt/go-install tools at runtime (required offline)
SUBSCRAPER_SKIP_AUTO_INSTALL=1
